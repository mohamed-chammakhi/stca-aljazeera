@startuml
title Sequence Diagram "Manual Laboratory Analysis Submission"

actor "Laboratory Technician" as L
boundary "Laboratory Analysis Interface" as I
control "Laboratory Service" as S
control "Django Laboratory API" as API
entity "Laboratory Analysis Model" as M

group Manual Laboratory Analysis Submission
    L -> I : 1. Open laboratory analysis page
    I -> S : 2. Request samples to analyze
    S -> API : 3. Fetch physically received samples
    API -> M : 4. Retrieve laboratory analysis data
    M --> API : 5. Return analysis data
    API --> S : 6. Return samples
    S --> I : 7. Return samples
    I --> L : 8. Display samples to analyze

    L -> I : 9. Fill laboratory analysis form manually
    I -> I : 10. Validate required chemical parameters

    alt If data is invalid
        I --> L : 10.1 Display validation error
    else If data is valid
        I -> S : 11. Send laboratory analysis
        S -> API : 12. Submit analysis
        API -> M : 13. Save analysis as submitted
        M --> API : 14. Confirm submission
        API --> S : 15. Return submitted analysis
        S --> I : 16. Return submission result
        I --> L : 17. Display submission confirmation
    end
end

@enduml
