@startuml
title Sequence Diagram "Confirm Physical Reception"

actor "Panel Member / Supervisor" as P
boundary "Sample Management Interface" as I
control "Panel Sample Service" as S
control "Django Echantillon API" as API
entity "Echantillon Model" as M

group Confirm Physical Reception
    P -> I : 1. Open sample management page
    I -> S : 2. Request olive oil samples
    S -> API : 3. Fetch samples
    API -> M : 4. Retrieve samples
    M --> API : 5. Return samples
    API --> S : 6. Return sample list
    S --> I : 7. Return samples
    I --> P : 8. Display samples

    P -> I : 9. Confirm physical reception
    I -> S : 10. Send reception confirmation
    S -> API : 11. Submit reception update
    API -> M : 12. Set sample as physically received
    M --> API : 13. Confirm update
    API --> S : 14. Return updated sample
    S --> I : 15. Return update result
    I --> P : 16. Display confirmation message
end

@enduml
