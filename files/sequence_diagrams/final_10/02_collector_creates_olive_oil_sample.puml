@startuml
title Sequence Diagram "Collector Creates an Olive Oil Sample"

actor "Collector" as C
boundary "Add Olive Oil Sample Interface" as I
control "Collector Sample Service" as S
control "Django Echantillon API" as API
entity "Echantillon Model" as M

group Create Olive Oil Sample
    C -> I : 1. Open the olive oil sample form
    I --> C : 2. Display the form

    C -> I : 3. Enter olive oil sample information
    I -> I : 4. Validate required fields

    alt If data is invalid
        I --> C : 4.1 Display validation error
    else If data is valid
        I -> S : 5. Send sample data
        S -> API : 6. Submit creation request
        API -> M : 7. Create olive oil sample
        M --> API : 8. Return created sample
        API --> S : 9. Return creation response
        S --> I : 10. Return created sample
        I --> C : 11. Display success message
    end
end

@enduml
