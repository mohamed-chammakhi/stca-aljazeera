@startuml
title Sequence Diagram "Authentication and Role-Based Redirection"

actor "User" as U
boundary "Login Interface" as I
control "Authentication Service" as S
control "Django Authentication API" as API
entity "User Model" as M
database "Secure Storage" as SS
boundary "Role-Based Interface" as R

group Authentication
    U -> I : 1. Enter email and password
    I -> I : 2. Validate required fields

    alt If data is invalid
        I --> U : 2.1 Display validation error
    else If data is valid
        I -> S : 3. Send credentials
        S -> API : 4. Submit login request
        API -> M : 5. Verify user credentials
        M --> API : 6. Return user and role

        alt If authentication fails
            API --> S : 6.1 Return authentication error
            S --> I : 6.2 Return error message
            I --> U : 6.3 Display login error
        else If authentication succeeds
            API --> S : 7. Return tokens and role
            S -> SS : 8. Store authentication tokens
            S --> I : 9. Return authenticated role
            I -> R : 10. Redirect according to role
            R --> U : 11. Display user interface
        end
    end
end

@enduml
