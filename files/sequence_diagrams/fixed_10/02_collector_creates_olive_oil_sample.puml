@startuml
title Sequence Diagram "Collector Creates an Olive Oil Sample"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Collector" as C
boundary "Add Olive Oil Sample Interface" as I
control "Collector Sample Service" as S
control "Django Echantillon API" as API
entity "Echantillon Model" as M

group Create Olive Oil Sample
    C -> I : Open the olive oil sample form
    I --> C : Display the form

    C -> I : Enter olive oil sample information
    I -> I : Validate required fields

    alt If data is invalid
        I --> C : Display validation error
    else If data is valid
        I -> S : Send sample data
        S -> API : Submit creation request
        API -> M : Create olive oil sample
        M --> API : Return created sample
        API --> S : Return creation response
        S --> I : Return created sample
        I --> C : Display success message
    end
end

@enduml
