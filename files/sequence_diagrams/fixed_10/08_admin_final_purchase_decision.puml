@startuml
title Sequence Diagram "Administrator Validates Final Purchase Decision"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Administrator" as A
boundary "Purchase Validation Interface" as I
control "Administrator Sample Service" as S
control "Django Echantillon API" as API
entity "Echantillon Model" as M

group Final Purchase Decision
    A -> I : Open purchase validation page
    I -> S : Request purchase proposals
    S -> API : Fetch samples waiting for validation
    API -> M : Retrieve purchase proposals
    M --> API : Return proposals
    API --> S : Return proposals
    S --> I : Return proposal list
    I --> A : Display purchase proposals

    A -> I : Choose final decision

    alt If purchase is confirmed
        I -> S : Send purchase confirmation
        S -> API : Submit confirmation request
        API -> M : Update sample status to "Achat confirmé"
        M --> API : Confirm update
        API --> S : Return updated sample
        S --> I : Return confirmation result
        I --> A : Display confirmation message
    else If purchase is refused
        A -> I : Enter refusal reason
        I -> S : Send purchase refusal
        S -> API : Submit refusal request
        API -> M : Update sample status to refused
        M --> API : Confirm update
        API --> S : Return updated sample
        S --> I : Return refusal result
        I --> A : Display refusal message
    end
end

@enduml
