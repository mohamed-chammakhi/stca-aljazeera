@startuml
title Sequence Diagram "Collector Confirms Purchase Information"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Collector" as C
boundary "Collector Samples Interface" as I
control "Collector Sample Service" as S
control "Django Echantillon API" as API
entity "Echantillon Model" as M

group Confirm Purchase Information
    C -> I : Open collector samples page
    I -> S : Request collector samples
    S -> API : Fetch collector samples
    API -> M : Retrieve collector samples
    M --> API : Return samples
    API --> S : Return samples
    S --> I : Return samples
    I --> C : Display samples with negotiation status

    C -> I : Select confirm purchase
    I --> C : Display purchase confirmation form
    C -> I : Enter final price, truck information, and stock delivery planning
    I -> I : Validate required fields

    alt If data is invalid
        I --> C : Display validation error
    else If data is valid
        I -> S : Send purchase confirmation data
        S -> API : Submit purchase confirmation
        API -> M : Update purchase information
        M --> API : Confirm update
        API --> S : Return updated sample
        S --> I : Return confirmation result
        I --> C : Display confirmation message
    end
end

@enduml
