@startuml
title Sequence Diagram "Manual Laboratory Analysis Submission"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Laboratory Technician" as L
boundary "Laboratory Analysis Interface" as I
control "Laboratory Service" as S
control "Django Laboratory API" as API
entity "Laboratory Analysis Model" as M

group Manual Laboratory Analysis Submission
    L -> I : Open laboratory analysis page
    I -> S : Request samples to analyze
    S -> API : Fetch physically received samples
    API -> M : Retrieve laboratory analysis data
    M --> API : Return analysis data
    API --> S : Return samples
    S --> I : Return samples
    I --> L : Display samples to analyze

    L -> I : Fill laboratory analysis form manually
    I -> I : Validate required chemical parameters

    alt If data is invalid
        I --> L : Display validation error
    else If data is valid
        I -> S : Send laboratory analysis
        S -> API : Submit analysis
        API -> M : Save analysis as submitted
        M --> API : Confirm submission
        API --> S : Return submitted analysis
        S --> I : Return submission result
        I --> L : Display submission confirmation
    end
end

@enduml
