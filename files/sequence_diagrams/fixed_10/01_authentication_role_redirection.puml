@startuml
title Sequence Diagram "Authentication and Role-Based Redirection"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam database {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "User" as U
boundary "Login Interface" as I
control "Authentication Service" as S
control "Django Authentication API" as API
entity "User Model" as M
database "Secure Storage" as SS
boundary "Role-Based Interface" as R

group Authentication
    U -> I : Enter email and password
    I -> I : Validate required fields

    alt If data is invalid
        I --> U : Display validation error
    else If data is valid
        I -> S : Send credentials
        S -> API : Submit login request
        API -> M : Verify user credentials
        M --> API : Return user and role

        alt If authentication fails
            API --> S : Return authentication error
            S --> I : Return error message
            I --> U : Display login error
        else If authentication succeeds
            API --> S : Return tokens and role
            S -> SS : Store authentication tokens
            S --> I : Return authenticated role
            I -> R : Redirect according to role
            R --> U : Display user interface
        end
    end
end

@enduml
