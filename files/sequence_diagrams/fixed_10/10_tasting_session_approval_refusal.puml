@startuml
title Sequence Diagram "Tasting Session Approval or Refusal"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Panel Evaluation Supervisor" as P
boundary "Tasting Session Interface" as I
control "Session Service" as S
control "Django Session API" as API
entity "Tasting Session Model" as M

group Tasting Session Approval or Refusal
    P -> I : Open tasting session page
    I -> S : Request tasting sessions
    S -> API : Fetch sessions
    API -> M : Retrieve sessions
    M --> API : Return sessions
    API --> S : Return session list
    S --> I : Return sessions
    I --> P : Display sessions with validation status

    P -> I : Select a pending session and choose decision

    alt If session is approved
        I -> S : Send approval decision
        S -> API : Submit approval request
        API -> M : Update session status to planned
        M --> API : Confirm update
        API --> S : Return updated session
        S --> I : Return approval result
        I --> P : Display approval confirmation
    else If session is refused
        I -> S : Send refusal decision
        S -> API : Submit refusal request
        API -> M : Update session status to refused
        M --> API : Confirm update
        API --> S : Return updated session
        S --> I : Forward refusal response
        I --> P : Display refusal confirmation
    end
end

@enduml
