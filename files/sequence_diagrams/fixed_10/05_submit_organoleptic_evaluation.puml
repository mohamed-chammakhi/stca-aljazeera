@startuml
title Sequence Diagram "Submit Organoleptic Evaluation"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam entity {
    BorderColor #3A6EA5
    BackgroundColor #E8F1FB
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Panel Member / Supervisor" as P
boundary "Evaluation Interface" as I
control "Evaluation Service" as S
control "Django Evaluation API" as API
entity "Organoleptic Evaluation Model" as M

group Submit Organoleptic Evaluation
    P -> I : Open evaluation page
    I -> S : Request samples to evaluate
    S -> API : Fetch evaluation data
    API -> M : Retrieve evaluation status
    M --> API : Return evaluation data
    API --> S : Return samples
    S --> I : Return samples
    I --> P : Display evaluation list

    P -> I : Fill organoleptic evaluation form
    I -> I : Validate required criteria

    alt If data is invalid
        I --> P : Display validation error
    else If data is valid
        I -> S : Send final evaluation
        S -> API : Submit evaluation
        API -> M : Save evaluation as submitted
        M --> API : Confirm submission
        API --> S : Return submitted evaluation
        S --> I : Return submission result
        I --> P : Display submission confirmation
    end
end

@enduml
