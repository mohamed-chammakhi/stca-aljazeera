@startuml
title Sequence Diagram "Bottle-Label OCR During Sample Creation"

autonumber

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor #1A2E1F
    BackgroundColor #DCE9E2
    FontStyle bold
}
skinparam boundary {
    BorderColor #38835A
    BackgroundColor #F5FBF7
}
skinparam control {
    BorderColor #D07B2F
    BackgroundColor #FEF3E8
}
skinparam sequence {
    ArrowColor #38835A
    LifeLineBorderColor #38835A
    GroupBorderColor #616161
    GroupBackgroundColor #F8F8F8
    GroupHeaderFontStyle bold
}

actor "Collector" as C
boundary "Add Olive Oil Sample Interface" as I
control "Collector Sample Service" as S
control "Local OCR Service (EasyOCR)" as OCR

note over OCR : Runs fully offline\non the mobile device

group Bottle-Label OCR During Sample Creation
    C -> I : Select bottle-label photo
    I -> S : Send photo for OCR extraction
    S -> OCR : Process bottle-label image locally
    OCR --> S : Return extracted text fields
    S --> I : Return OCR result

    I --> C : Display extracted fields
    C -> I : Verify and correct the fields
    I -> I : Fill the sample form with verified data
end

@enduml
