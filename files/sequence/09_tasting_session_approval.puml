@startuml
title Diagramme de sequence - Gestion et validation d'une seance de degustation

actor "Degustateur" as Taster
actor "Chef de Panel" as Chef
boundary "Interface Seances de Degustation" as UI
control "Controleur Seance" as Controller
entity "Modele Seance" as Session
database "Base de donnees" as DB

Taster -> UI : Demander la page des seances
UI -> Controller : Charger les seances de degustation
Controller -> Session : Recuperer les seances
Session -> DB : Lire les seances
DB --> Session : Retourner la liste
Session --> Controller : Liste des seances
Controller --> UI : Envoyer la liste
UI --> Taster : Afficher les seances

Taster -> UI : Proposer une nouvelle seance
UI --> Taster : Afficher le formulaire de seance
Taster -> UI : Saisir date, heure, lieu et echantillons
UI -> UI : Verifier les champs obligatoires

alt Donnees invalides
    UI --> Taster : Afficher un message d'erreur
else Donnees valides
    UI -> Controller : Envoyer la proposition de seance
    Controller -> Session : Creer une seance en attente
    Session -> DB : Enregistrer la seance proposee
    DB --> Session : Confirmation
    Session --> Controller : Seance en attente
    Controller --> UI : Confirmer la proposition
    UI --> Taster : Afficher un message de succes
end

Chef -> UI : Consulter les seances proposees
UI -> Controller : Charger les seances en attente
Controller -> Session : Recuperer les seances en attente
Session -> DB : Lire les seances en attente
DB --> Session : Retourner la liste
Session --> Controller : Liste des seances en attente
Controller --> UI : Envoyer la liste
UI --> Chef : Afficher les seances a valider

Chef -> UI : Approuver ou refuser une seance
UI -> Controller : Envoyer la decision
Controller -> Session : Verifier l'etat de la seance
Session -> DB : Lire l'etat actuel
DB --> Session : Etat de la seance

alt Seance deja traitee
    Session --> Controller : Validation impossible
    Controller --> UI : Refuser l'operation
    UI --> Chef : Afficher un message d'erreur
else Decision valide
    Controller -> Session : Mettre a jour le statut
    Session -> DB : Enregistrer approbation ou refus
    DB --> Session : Confirmation
    Session --> Controller : Statut mis a jour
    Controller --> UI : Confirmer la decision
    UI --> Chef : Afficher un message de succes
end

@enduml
