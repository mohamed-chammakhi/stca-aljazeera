@startuml
title Diagramme de sequence - Confirmation d'achat et suivi de livraison

actor "Collecteur" as Collector
actor "Administrateur" as Admin
boundary "Interface Achats Confirmes" as UI
control "Controleur Achat" as Controller
entity "Modele Achat" as Purchase
entity "Modele Echantillon" as Sample
database "Base de donnees" as DB

Collector -> UI : Consulter les echantillons approuves
UI -> Controller : Charger les echantillons en negociation
Controller -> Sample : Recuperer les echantillons eligibles
Sample -> DB : Lire les echantillons approuves
DB --> Sample : Retourner la liste
Sample --> Controller : Liste des echantillons
Controller --> UI : Envoyer la liste
UI --> Collector : Afficher les echantillons en negociation

Collector -> UI : Confirmer l'achat
UI --> Collector : Afficher le formulaire de confirmation
Collector -> UI : Saisir les informations de negociation et livraison
UI -> UI : Verifier les champs obligatoires

alt Donnees invalides
    UI --> Collector : Afficher un message d'erreur
else Donnees valides
    UI -> Controller : Envoyer la confirmation d'achat
    Controller -> Sample : Verifier le statut de l'echantillon
    Sample -> DB : Lire l'etat actuel
    DB --> Sample : Etat de l'echantillon

    alt Echantillon non approuve
        Sample --> Controller : Achat non autorise
        Controller --> UI : Refuser la confirmation
        UI --> Collector : Afficher un message d'erreur
    else Echantillon approuve
        Controller -> Purchase : Creer l'achat confirme
        Purchase -> DB : Enregistrer l'achat et les donnees de livraison
        DB --> Purchase : Confirmation
        Controller -> Sample : Mettre a jour le statut achat confirme
        Sample -> DB : Enregistrer le nouveau statut
        DB --> Sample : Confirmation
        Controller --> UI : Confirmer l'achat
        UI --> Collector : Afficher un message de succes
    end
end

Admin -> UI : Consulter les achats confirmes
UI -> Controller : Charger les achats confirmes
Controller -> Purchase : Recuperer les achats
Purchase -> DB : Lire les achats confirmes
DB --> Purchase : Retourner la liste
Purchase --> Controller : Liste des achats
Controller --> UI : Envoyer les achats
UI --> Admin : Afficher les achats et le suivi de livraison

@enduml
