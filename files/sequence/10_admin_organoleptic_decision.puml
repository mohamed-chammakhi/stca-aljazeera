@startuml
title Diagramme de sequence - Decision administrateur apres analyse organoleptique

actor "Administrateur" as Admin
boundary "Interface Analyses Organoleptiques" as UI
control "Controleur Analyse Organoleptique" as Controller
entity "Modele Evaluation" as Evaluation
entity "Modele Echantillon" as Sample
database "Base de donnees" as DB

Admin -> UI : Demander la page des analyses organoleptiques
UI -> Controller : Charger les evaluations soumises
Controller -> Evaluation : Recuperer les evaluations organoleptiques
Evaluation -> DB : Lire les evaluations soumises
DB --> Evaluation : Retourner les evaluations
Evaluation --> Controller : Liste des evaluations
Controller --> UI : Envoyer la liste
UI --> Admin : Afficher les evaluations

Admin -> UI : Selectionner un echantillon
UI -> Controller : Charger les resultats de l'echantillon
Controller -> Evaluation : Recuperer les evaluations du panel
Evaluation -> DB : Lire les resultats lies a l'echantillon
DB --> Evaluation : Retourner les resultats
Evaluation --> Controller : Resultats du panel
Controller --> UI : Envoyer les details
UI --> Admin : Afficher les resultats organoleptiques

Admin -> UI : Approuver ou refuser l'echantillon
UI -> Controller : Envoyer la decision
Controller -> Sample : Verifier l'etat de l'echantillon
Sample -> DB : Lire l'etat actuel
DB --> Sample : Etat de l'echantillon

alt Decision deja effectuee
    Sample --> Controller : Decision impossible
    Controller --> UI : Refuser la duplication
    UI --> Admin : Afficher un message d'erreur
else Resultats insuffisants
    Sample --> Controller : Decision non autorisee
    Controller --> UI : Refuser la decision
    UI --> Admin : Afficher un message d'information
else Decision valide
    Controller -> Sample : Mettre a jour le statut de l'echantillon
    Sample -> DB : Enregistrer approbation ou refus
    DB --> Sample : Confirmation
    Sample --> Controller : Statut mis a jour
    Controller --> UI : Confirmer la decision
    UI --> Admin : Afficher un message de succes
end

@enduml
