@startuml
title Diagramme de sequence - Gestion et reception physique des echantillons

actor "Degustateur / Chef de Panel" as Panel
boundary "Interface Gestion Echantillons" as UI
control "Controleur Echantillon" as Controller
entity "Modele Echantillon" as Model
database "Base de donnees" as DB

Panel -> UI : Demander la page de gestion des echantillons
UI -> Controller : Charger les echantillons disponibles
Controller -> Model : Recuperer les echantillons
Model -> DB : Lire les echantillons
DB --> Model : Retourner la liste
Model --> Controller : Liste des echantillons
Controller --> UI : Envoyer la liste
UI --> Panel : Afficher les echantillons

Panel -> UI : Selectionner un echantillon
UI -> Controller : Charger les details de l'echantillon
Controller -> Model : Recuperer les details
Model -> DB : Lire l'echantillon selectionne
DB --> Model : Retourner les details
Model --> Controller : Details de l'echantillon
Controller --> UI : Envoyer les details
UI --> Panel : Afficher les informations

Panel -> UI : Confirmer la reception physique
UI -> Controller : Envoyer la confirmation de reception
Controller -> Model : Verifier l'etat de l'echantillon
Model -> DB : Lire l'etat actuel
DB --> Model : Etat de l'echantillon

alt Reception deja confirmee
    Model --> Controller : Reception deja effectuee
    Controller --> UI : Refuser la duplication
    UI --> Panel : Afficher un message d'information
else Reception non confirmee
    Controller -> Model : Mettre a jour la reception physique
    Model -> DB : Enregistrer recu physiquement
    DB --> Model : Confirmation
    Model --> Controller : Reception confirmee
    Controller --> UI : Confirmer l'operation
    UI --> Panel : Afficher un message de succes
end

@enduml
