@startuml
title Diagramme de sequence - Consultation de la carte geographique

actor "Collecteur" as Collector
boundary "Interface Carte Geographique" as UI
control "Controleur Carte" as Controller
entity "Service Geographique" as GeoService
entity "Modele Echantillon" as Sample
database "Base de donnees" as DB

Collector -> UI : Demander la carte geographique
UI -> Controller : Charger les donnees de la carte
Controller -> GeoService : Recuperer les zones geographiques
GeoService --> Controller : Retourner les delegations
Controller -> Sample : Recuperer les echantillons localises
Sample -> DB : Lire les echantillons avec localisation
DB --> Sample : Retourner les echantillons
Sample --> Controller : Liste des echantillons localises
Controller --> UI : Envoyer zones et echantillons
UI --> Collector : Afficher la carte

Collector -> UI : Selectionner une zone ou un marqueur
UI -> Controller : Demander les details de la zone
Controller -> Sample : Filtrer les echantillons par zone
Sample -> DB : Rechercher les echantillons de la zone
DB --> Sample : Retourner les resultats
Sample --> Controller : Echantillons de la zone
Controller --> UI : Envoyer les details

alt Aucun echantillon trouve
    UI --> Collector : Afficher une zone sans echantillons
else Echantillons disponibles
    UI --> Collector : Afficher les echantillons de la zone
end

@enduml
