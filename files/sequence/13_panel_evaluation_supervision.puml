@startuml
title Diagramme de sequence - Supervision des evaluations du panel

actor "Chef de Panel" as Chef
boundary "Interface Supervision Evaluations" as UI
control "Controleur Supervision" as Controller
control "Service Detection IA" as AI
entity "Modele Evaluation" as Evaluation
entity "Modele Echantillon" as Sample
database "Base de donnees" as DB

Chef -> UI : Demander la page de supervision
UI -> Controller : Charger les evaluations soumises
Controller -> Evaluation : Recuperer les evaluations du panel
Evaluation -> DB : Lire les evaluations soumises
DB --> Evaluation : Retourner les evaluations
Evaluation --> Controller : Liste des evaluations
Controller --> UI : Envoyer les evaluations
UI --> Chef : Afficher les evaluations du panel

Chef -> UI : Selectionner un echantillon
UI -> Controller : Charger les resultats detailles
Controller -> Sample : Recuperer les informations de l'echantillon
Sample -> DB : Lire l'echantillon selectionne
DB --> Sample : Retourner l'echantillon
Sample --> Controller : Details de l'echantillon

Controller -> Evaluation : Recuperer les evaluations liees
Evaluation -> DB : Lire les resultats des degustateurs
DB --> Evaluation : Retourner les resultats
Evaluation --> Controller : Resultats du panel

Controller -> AI : Comparer les scores et detecter les divergences
AI --> Controller : Retourner comparaison et alertes
Controller --> UI : Envoyer details, comparaison et divergences
UI --> Chef : Afficher les resultats cote a cote

alt Divergence detectee
    UI --> Chef : Afficher une alerte de divergence
else Aucune divergence
    UI --> Chef : Afficher des resultats coherents
end

Chef -> UI : Consulter les details d'une evaluation
UI -> Controller : Demander les details
Controller -> Evaluation : Recuperer l'evaluation selectionnee
Evaluation -> DB : Lire l'evaluation
DB --> Evaluation : Retourner les details
Evaluation --> Controller : Details de l'evaluation
Controller --> UI : Envoyer les details
UI --> Chef : Afficher l'evaluation selectionnee

@enduml
