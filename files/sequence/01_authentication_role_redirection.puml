@startuml
title Diagramme de sequence - Authentification et redirection selon le role

actor "Utilisateur" as User
boundary "Interface Authentification" as UI
control "Controleur Authentification" as Auth
entity "Modele Utilisateur" as Model
database "Base de donnees" as DB

User -> UI : Demander la page de connexion
UI --> User : Afficher le formulaire de connexion

User -> UI : Saisir identifiant et mot de passe
UI -> UI : Verifier les champs obligatoires

alt Champs invalides ou vides
    UI --> User : Afficher un message d'erreur
else Champs valides
    UI -> Auth : Envoyer les identifiants
    Auth -> Model : Verifier l'existence du compte
    Model -> DB : Rechercher l'utilisateur
    DB --> Model : Retourner les informations du compte
    Model --> Auth : Resultat de verification

    alt Compte inexistant ou mot de passe incorrect
        Auth --> UI : Refuser l'authentification
        UI --> User : Afficher un message d'erreur
    else Compte desactive
        Auth --> UI : Refuser l'acces
        UI --> User : Afficher un message de compte desactive
    else Compte valide
        Auth -> Auth : Generer le jeton de session
        Auth --> UI : Retourner role et jeton
        UI -> UI : Enregistrer la session utilisateur
        UI --> User : Rediriger vers l'interface selon le role
    end
end

@enduml
