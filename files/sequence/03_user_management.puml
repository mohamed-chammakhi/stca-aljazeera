@startuml
title Diagramme de sequence - Gestion des utilisateurs

actor "Administrateur" as Admin
boundary "Interface Gestion Utilisateurs" as UI
control "Controleur Utilisateur" as Controller
entity "Modele Utilisateur" as Model
database "Base de donnees" as DB

Admin -> UI : Demander la page de gestion des utilisateurs
UI -> Controller : Charger la liste des utilisateurs
Controller -> Model : Recuperer les utilisateurs
Model -> DB : Lire les comptes utilisateurs
DB --> Model : Retourner la liste
Model --> Controller : Liste des utilisateurs
Controller --> UI : Envoyer la liste
UI --> Admin : Afficher les utilisateurs

Admin -> UI : Choisir une action\n(ajouter, modifier, activer/desactiver, supprimer)

alt Ajouter ou modifier un utilisateur
    UI --> Admin : Afficher le formulaire
    Admin -> UI : Saisir les informations
    UI -> UI : Verifier les champs

    alt Donnees invalides
        UI --> Admin : Afficher un message d'erreur
    else Donnees valides
        UI -> Controller : Envoyer les donnees utilisateur
        Controller -> Model : Verifier l'unicite de l'identifiant
        Model -> DB : Rechercher un compte existant
        DB --> Model : Resultat de recherche

        alt Identifiant deja utilise
            Model --> Controller : Compte deja existant
            Controller --> UI : Refuser l'operation
            UI --> Admin : Afficher un message d'erreur
        else Identifiant disponible
            Controller -> Model : Enregistrer l'utilisateur
            Model -> DB : Ajouter ou modifier le compte
            DB --> Model : Confirmation
            Model --> Controller : Operation validee
            Controller --> UI : Confirmer l'operation
            UI --> Admin : Afficher un message de succes
        end
    end

else Activer ou desactiver un utilisateur
    UI -> Controller : Envoyer le changement d'etat
    Controller -> Model : Modifier l'etat du compte
    Model -> DB : Mettre a jour le compte
    DB --> Model : Confirmation
    Model --> Controller : Etat mis a jour
    Controller --> UI : Confirmer la modification
    UI --> Admin : Afficher un message de succes

else Supprimer un utilisateur
    UI --> Admin : Demander confirmation
    Admin -> UI : Confirmer la suppression
    UI -> Controller : Envoyer la demande de suppression
    Controller -> Model : Supprimer le compte
    Model -> DB : Supprimer l'utilisateur
    DB --> Model : Confirmation
    Model --> Controller : Suppression validee
    Controller --> UI : Confirmer la suppression
    UI --> Admin : Mettre a jour la liste
end

@enduml
