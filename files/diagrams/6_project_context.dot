digraph project_context {
    graph [
        rankdir=TB
        bgcolor="white"
        fontname="Arial"

        nodesep=1.4
        ranksep=0.85
        pad=0.6
        label="Al Jazira STCA — Olive Oil Sample Evaluation Process"
        labelfontsize=15
        labelfontname="Arial Bold"
        labelfontcolor="#1A2E1F"
        labelloc=t
    ]

    node [fontname="Arial" fontsize=11 style="filled,rounded" penwidth=1.8]
    edge [fontname="Arial" fontsize=9 penwidth=1.6 arrowsize=0.85]

    // ── External actors ──────────────────────────────────────────
    suppliers [
        label="Olive Oil\nSuppliers"
        shape=rectangle
        fillcolor="#FEF3E8"
        color="#D07B2F"
        fontcolor="#7A4A15"
        fontname="Arial Bold"
        width=2.4
        height=0.85
    ]

    collector [
        label="Field Collector\n──────────────\nCollects small bottles\nfrom supplier sites"
        shape=rectangle
        fillcolor="#E8F1FB"
        color="#3A6EA5"
        fontcolor="#1A3A5C"
        width=2.8
        height=1.1
    ]

    // ── Company boundary ─────────────────────────────────────────
    subgraph cluster_company {
        label="  Al Jazira STCA  "
        style="filled,rounded"
        fillcolor="#F5FBF7"
        color="#38835A"
        penwidth=2.8
        fontname="Arial Bold"
        fontsize=13
        fontcolor="#38835A"

        reception [
            label="Sample Reception\n──────────────\nPhysical verification\nupon arrival"
            shape=rectangle
            fillcolor="#DCE9E2"
            color="#38835A"
            fontcolor="#1A2E1F"
            width=2.8
            height=1.1
        ]

        panel [
            label="Quality Service\n──────────────\nTrained Panel Members\nSensory Evaluation\n(Tasting & Classification)"
            shape=rectangle
            fillcolor="#DCE9E2"
            color="#38835A"
            fontcolor="#1A2E1F"
            width=2.8
            height=1.4
        ]

        lab [
            label="Laboratory\n──────────────\nLab Technician\nChemical Analysis"
            shape=rectangle
            fillcolor="#DCE9E2"
            color="#38835A"
            fontcolor="#1A2E1F"
            width=2.8
            height=1.4
        ]

        admin [
            label="Administrator\n──────────────\nReviews sensory results\n+ chemical analysis\nMakes purchase decision"
            shape=rectangle
            fillcolor="#1A2E1F"
            color="#1A2E1F"
            fontcolor="#FFFFFF"
            fontname="Arial Bold"
            width=2.8
            height=1.4
        ]

        purchase_ok [
            label="Batch Purchased\n──────────────\nProcessing &\nDistribution"
            shape=rectangle
            fillcolor="#38835A"
            color="#38835A"
            fontcolor="#FFFFFF"
            fontname="Arial Bold"
            width=2.4
            height=1.0
        ]

        refused [
            label="Batch Refused\n──────────────\nNot suitable\nfor production"
            shape=rectangle
            fillcolor="#BF3628"
            color="#BF3628"
            fontcolor="#FFFFFF"
            fontname="Arial Bold"
            width=2.4
            height=1.0
        ]

        { rank=same panel lab }
        { rank=same purchase_ok refused }

        reception -> panel [
            label="Samples for\nsensory evaluation"
            color="#38835A"
            fontcolor="#38835A"
        ]
        reception -> lab [
            label="Samples for\nchemical analysis"
            color="#38835A"
            fontcolor="#38835A"
        ]
        panel -> admin [
            label="Sensory\nresults"
            color="#38835A"
            fontcolor="#38835A"
        ]
        lab -> admin [
            label="Chemical\nresults"
            color="#38835A"
            fontcolor="#38835A"
        ]
        admin -> purchase_ok [
            label="Approved"
            color="#38835A"
            fontcolor="#38835A"
            style=bold
        ]
        admin -> refused [
            label="Refused"
            color="#BF3628"
            fontcolor="#BF3628"
            style=bold
        ]
    }

    // ── External edges ───────────────────────────────────────────
    suppliers -> collector [
        label="Small olive oil\nbottles (samples)"
        color="#D07B2F"
        fontcolor="#D07B2F"
    ]
    collector -> reception [
        label="Delivers samples\nto company"
        color="#3A6EA5"
        fontcolor="#3A6EA5"
    ]
}
