// Hierarchy (from 3_hierarchy) KEPT as-is, with the process-flow connections
// (from 2_workflow, minus the Supplier) drawn on top.
//   grey lines  = organisational hierarchy
//   green arrows = process flow (who sends what to whom)
// Render: dot -Tpng 5_hierarchy_workflow.dot -o 5_hierarchy_workflow.png
digraph combined {
  graph [charset="UTF-8", rankdir=TB, dpi=150, bgcolor="white", pad=0.4,
         nodesep=0.9, ranksep=1.2, fontname="Arial", splines=true];
  node [shape=box, style="filled,rounded", fontname="Arial", fontsize=12,
        fillcolor="#DCE9E2", fontcolor="#1A2E1F"];

  admin      [label="Administrator\n(Directeur)", fillcolor="#38835A", fontcolor="white"];
  supervisor [label="Panel Evaluation Supervisor\n(Chef Dégustateur)"];
  collector  [label="Collector\n(Collecteur)"];
  lab        [label="Laboratory Technician\n(Technicien Labo)"];
  panel      [label="Tasting Panel Member\n(Dégustateur)"];

  // ---- organisational hierarchy (same as 3_hierarchy) : grey, no arrows ----
  edge [color="#9AA39E", penwidth=1.2, arrowhead=none, constraint=true];
  admin -> supervisor;
  admin -> collector;
  admin -> lab;
  supervisor -> panel;

  // ---- process flow (from 2_workflow, no supplier) : green arrows ----
  edge [color="#38835A", penwidth=1.9, arrowhead=normal, arrowsize=0.9,
        constraint=false, fontcolor="#1A2E1F", fontsize=10];
  collector -> panel [label="échantillon"];
  collector -> lab   [label="échantillon"];
  panel -> supervisor [label="score sensoriel"];
  lab   -> supervisor [label="résultats labo"];
  supervisor -> admin [label="évaluation"];
}
